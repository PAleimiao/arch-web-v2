---
import '../styles/global.css';

// BASE_URL 不带尾斜杠（base='/' 时就是 '/'），统一归一成 '' 或 '/xxx'
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// @astrojs/react 只在「页面含 client:* island」时注入 Fast Refresh preamble。
// 本页是纯客户端空壳，React 由下方 script 动态 import，dev 下若不补这段，
// Vite 编译出的组件模块顶层会因 $RefreshSig$ 未定义而抛错，页面只剩空背景。
// 生产构建（DEV=false）不输出，产物不受影响。
// 内容与 @astrojs/react 在 dev 下通过 before-hydration 注入的完全一致
const refreshPreamble = `
  import { injectIntoGlobalHook } from "/@react-refresh";
  injectIntoGlobalHook(window);
  window.$RefreshReg$ = () => {};
  window.$RefreshSig$ = () => (type) => type;
`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Arch Web OS</title>
    <meta name="description" content="运行在浏览器里的 Arch Linux 桌面环境" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}/favicon.svg`}
    />
    <meta name="theme-color" content="#0b0e14" />
  </head>
  <body>
    <div id="os-root"></div>
    {import.meta.env.DEV && (
      <script is:inline type="module" set:html={refreshPreamble}></script>
    )}
  </body>
</html>

<script>
  // 桌面环境是纯客户端应用，Astro 只负责吐出首屏空壳
  import('../shell/mount');
</script>
